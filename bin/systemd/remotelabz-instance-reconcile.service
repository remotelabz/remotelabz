[Unit]
Description=RemoteLabz Reconcile Stuck Instances Service
After=network.target

[Service]
# La commande se termine après son exécution : c'est le timer
# (remotelabz-instance-reconcile.timer) qui relance la périodicité
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/remotelabz
ExecStart=/usr/bin/php /opt/remotelabz/bin/console app:instance:reconcile-starting --no-interaction
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min

PrivateTmp=true

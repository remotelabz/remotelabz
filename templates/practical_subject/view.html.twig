<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ subject.name }} — {{ lab.name }}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.6;
            color: #212529;
            margin: 0;
            background: #fff;
        }
        .toolbar {
            position: sticky;
            top: 0;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .toolbar .lab-name {
            color: #6c757d;
            font-size: 0.9rem;
        }
        .toolbar button {
            background: #0d6efd;
            color: #fff;
            border: none;
            border-radius: 0.25rem;
            padding: 0.5rem 1rem;
            font-size: 1rem;
            cursor: pointer;
        }
        .toolbar button:hover {
            background: #0b5ed7;
        }
        .subject-content {
            max-width: 52rem;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
        }
        .subject-content h1 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 0.5rem;
        }
        .subject-content img {
            max-width: 100%;
        }
        .subject-content pre {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
            padding: 0.75rem;
            overflow-x: auto;
        }
        .subject-content code {
            background: #f8f9fa;
            padding: 0.1rem 0.3rem;
            border-radius: 0.2rem;
        }
        .subject-content pre code {
            background: none;
            padding: 0;
        }
        .subject-content table {
            border-collapse: collapse;
        }
        .subject-content table td,
        .subject-content table th {
            border: 1px solid #dee2e6;
            padding: 0.4rem 0.6rem;
        }
        @media print {
            .toolbar {
                display: none;
            }
            .subject-content {
                max-width: none;
                padding: 0;
            }
            body {
                font-size: 12pt;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <span class="lab-name">{{ subject.name }} — {{ lab.name }}</span>
        <button type="button" onclick="window.print()">{{ 'Imprimer le sujet'|trans }}</button>
    </div>
    <div class="subject-content">
        <h1>{{ subject.name }}</h1>
        {% if subject.description is not empty %}
            {% apply markdown_to_html %}
                {{ subject.description }}
            {% endapply %}
        {% else %}
            <p>{{ 'No content'|trans }}</p>
        {% endif %}
    </div>
</body>
</html>

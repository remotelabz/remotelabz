{% extends 'dashboard.base.html.twig' %}
{% import 'partials/directory.html.twig' as dir %}

{% block title %}Device Templates - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    {%- set breadcrumbs = breadcrumbs|merge({ 'Devices': is_granted("ROLE_ADMINISTRATOR") ? path('devices') : null }) -%}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'devices' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
<div class="top-panel">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="fa">Device Templates</h1>
        <div class="quick-actions d-flex gap-2">
            <a class="btn btn-success" role="button" href="{{ path('new_device') }}">
                <i class="fas fa-plus me-2"></i> New Virtual Device
            </a>&nbsp;
            <a class="btn btn-warning" role="button" href="{{ path('new_physical_device') }}">
                <i class="fas fa-server me-2"></i> New Physical Device (experimental)
            </a>
        </div>
    </div>
    
    <ul class="nav-links nav nav-tabs mt-3">
        <li class="nav-item">
            <a class="nav-link {% if app.request.query.get('type') is null %}active{% endif %}" 
               href="{{ path('devices', app.request.query|merge({type: null, page: null})) }}">
                <span>All</span> 
                <span class="badge bg-primary ms-1">{{ count.total }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if app.request.query.get('type') == 'vm' %}active{% endif %}" 
               href="{{ path('devices', app.request.query|merge({type: 'vm', page: null})) }}">
                <span>Virtual Machines</span> 
                <span class="badge bg-info ms-1">{{ count.vms }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if app.request.query.get('type') == 'container' %}active{% endif %}" 
               href="{{ path('devices', app.request.query|merge({type: 'container', page: null})) }}">
                <span>Containers</span> 
                <span class="badge bg-success ms-1">{{ count.containers }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if app.request.query.get('type') == 'physical' %}active{% endif %}" 
               href="{{ path('devices', app.request.query|merge({type: 'physical', page: null})) }}">
                <span>Physical Devices</span> 
                <span class="badge bg-warning ms-1">{{ count.physical }}</span>
            </a>
        </li>
    </ul>
</div>

<div class="search-panel mt-3">
    <div class="row">
        <div class="col-md-8">
            <form action="{{ path('devices') }}" method="GET" class="d-flex">
                <input type="search" class="form-control" name="search"
                       placeholder="Search by name, brand, or model..."
                       spellcheck="false" value="{{ search|default('') }}"
                       id="searchInput" style="flex-grow: 1; min-width: 0;">
                <select name="directory" class="form-select ms-2" style="width: 260px; flex-shrink: 0;"
                        onchange="this.form.submit()" title="Filter by directory (includes sub-directories)">
                    {{ dir.directory_options(directoryOptions|default({}), selectedDirectory|default('all')) }}
                </select>
                <button class="btn btn-outline-secondary ms-2" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>
        <div class="col-md-4">
            <div class="d-flex">
                <select class="form-select" style="width: auto;" id="osFilter">
                    <option value="">All Operating Systems</option>
                    {% for osName in osFilterOptions|default([]) %}
                        <option value="{{ osName|lower }}">{{ osName }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    {% if is_granted("ROLE_ADMINISTRATOR") %}
    <div class="mt-3">
        {{ dir.create_form(app.request.uri, directoryOptions|default({}), selectedDirectory is not null and selectedDirectory != 'all' and selectedDirectory != 'root' ? selectedDirectory : '', 'directory_admin') }}
    </div>
    {% endif %}
</div>

<div class="devices-panel mt-3">
    {% if devices is empty %}
        <div class="text-center py-5">
            <i class="fas fa-server fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No Device Templates Found</h4>
            <p class="text-muted">Get started by creating your first device template.</p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="{{ path('new_device') }}" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Create Virtual Device
                </a>
                <a href="{{ path('new_physical_device') }}" class="btn btn-outline-success">
                    <i class="fas fa-server me-2"></i>Create Physical Device
                </a>
            </div>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        {% if is_granted("ROLE_ADMINISTRATOR") %}
                        {{ dir.select_all_checkbox() }}                        {% endif %}
                        <th width="50">Type</th>
                        <th>Name</th>
                        <th width="150">Brand & Model</th>
                        <th width="120">vCPU</th>
                        <th width="120">Arch.</th>
                        <th width="150">Operating System</th>
                        <th width="180">Directory</th>
                        {% if is_granted("ROLE_TEACHER_EDITOR") %}
                            <th width="100">Actions</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody id="deviceTableBody">
                    {% for device in devices %}
                    <tr class="device-item"
                        data-type="{{ device.type }}"
                        data-os="{% if device.operatingSystem %}{{ device.operatingSystem.name|lower }}{% else %}none{% endif %}"
                        data-name="{{ device.name|lower }}"
                        data-brand="{{ device.brand|default('')|lower }}"
                        data-model="{{ device.model|default('')|lower }}">
                        {% if is_granted("ROLE_ADMINISTRATOR") %}
                        <td><input type="checkbox" class="item-check" value="{{ device.id }}"></td>                        {% endif %}
                        <td>
                            {% if device.type == 'vm' %}
                                <span class="badge bg-info">
                                    <i class="fas fa-desktop me-1"></i>&nbsp;VM
                                </span>
                            {% elseif device.type == 'container' %}
                                <span class="badge bg-success">
                                    <i class="fab fa-docker me-1"></i>&nbsp;Container
                                </span>
                            {% elseif device.type == 'physical' %}
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-server me-1"></i>&nbsp;Physical
                                </span>
                            {% elseif device.type == 'switch' %}
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-network-wired me-1"></i>&nbsp;Switch
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    <i class="fas fa-question me-1"></i>&nbsp;{{ device.type|title }}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div>
                                    <a href="{{ path('show_device', {'id': device.id}) }}" 
                                       class="text-decoration-none fw-medium">
                                        {{ device.name }}
                                    </a>
                                    
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if device.brand or device.model %}
                                <div class="small">
                                    {% if device.brand %}<strong>{{ device.brand }}</strong>{% endif %}<br/>
                                    {% if device.model %}{{ device.model }}{% endif %}
                                </div>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if device.virtuality %}
                                <span class="text-muted">{{ device.nbCpu|default(1) }} vCPU</span>
                                {% if device.flavor %}
                                    <div class="small text-muted">{{ device.flavor.memory }} MB RAM</div>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">Physical</span>
                            {% endif %}
                        </td>
                        <td>
                            
                               
                            {% if device.operatingSystem.arch %}
                                <span class="badge bg-light text-dark">{{ device.operatingSystem.arch.name }}</span>
                            {% elseif device.isos is not empty%}
                                {% set first_iso = device.isos|first %}
                                {% if first_iso and first_iso.arch %}
                                    <span class="badge bg-light text-dark">{{ first_iso.arch.name }}</span>
                                {% endif %}
                            {% else %}
                                <span class="badge bg-light text-dark">x86_64</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if device.operatingSystem %}
                                <span class="badge bg-light text-dark">{{ device.operatingSystem.name }}</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {{ dir.directory_cell(device) }}
                        </td>
                        {% if is_granted("ROLE_TEACHER_EDITOR") %}
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('edit_device', {'id': device.id}) }}"
                                    class="btn btn-sm btn-outline-primary"
                                    title="Edit Device">
                                    <i class="fas fa-edit"></i>
                                </a>
{% if is_granted("ROLE_ADMINISTRATOR") %}
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-move-id="{{ device.id }}" data-move-name="{{ device.name }}"
                                            title="Move to directory">
                                        <i class="fas fa-folder-open"></i>
                                    </button>
    {% endif %}
                                <form method="post" action="{{ path('delete_device', {id: device.id}) }}" style="display:inline-block;" onsubmit="return confirm('{{ 'Are you sure?'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ device.id) }}">
                                <input type="hidden" name="_method" value="DELETE">
                                <button class="btn btn-sm btn-outline-danger" title="{{ 'Delete'|trans }}">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                                
                            </div>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if is_granted("ROLE_ADMINISTRATOR") %}
        {{ dir.batch_bar(path('device_move'), app.request.uri, 'devices', directoryOptions|default({})) }}
        {{ dir.move_modal(path('device_move'), 'device', directoryOptions|default({})) }}        {% endif %}

        {# Pagination #}
        {% if pagination.pageCount > 1 %}
        <div class="row align-items-center mt-4">
            <div class="col-md-6">
                <div class="text-muted">
                    {% set start = (pagination.currentPageNumber - 1) * pagination.itemNumberPerPage + 1 %}
                    {% set end = pagination.currentPageNumber == pagination.pageCount ? pagination.totalItemCount : pagination.currentPageNumber * pagination.itemNumberPerPage %}

                    Showing <strong>{{ start }}</strong> to <strong>{{ end }}</strong>
                    of <strong>{{ pagination.totalItemCount }}</strong> device templates
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex justify-content-end">
                    {{ knp_pagination_render(pagination,'pagination/my_pagination.html.twig') }}
                </div>
            </div>
        </div>
        {% endif %}

        {% if pagination.pageCount == 1 and pagination.totalItemCount > 0 %}
        <div class="text-muted mt-3">
            Showing all {{ pagination.totalItemCount }} device templates
        </div>
        {% endif %}
    {% endif %}
</div>

{# Delete Confirmation Modal #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the device <strong id="deleteItemName"></strong>?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="#" class="btn btn-danger" id="confirmDeleteBtn">Delete</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Filter functionality
        document.addEventListener('DOMContentLoaded', function() {
            // OS filter
            const osFilter = document.getElementById('osFilter');
            const deviceItems = document.querySelectorAll('.device-item');
            
            if (osFilter && deviceItems.length > 0) {
                osFilter.addEventListener('change', function() {
                    const selectedOS = this.value.toLowerCase();
                    
                    deviceItems.forEach(item => {
                        if (!selectedOS || item.dataset.os === selectedOS) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }
            // Search functionality
            const searchInput = document.getElementById('searchInput');
            if (searchInput && deviceItems.length > 0) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    
                    deviceItems.forEach(item => {
                        const name = item.dataset.name;
                        const brand = item.dataset.brand;
                        const model = item.dataset.model;
                        const os = item.dataset.os;
                        
                        if (name.includes(searchTerm) || 
                            brand.includes(searchTerm) || 
                            model.includes(searchTerm) ||
                            os.includes(searchTerm)) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }
        });
        
        // Delete confirmation
        function confirmDelete(name, deleteUrl) {
            const deleteItemName = document.getElementById('deleteItemName');
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteModalElement = document.getElementById('deleteModal');
            
            if (deleteItemName && confirmDeleteBtn && deleteModalElement) {
                deleteItemName.textContent = name;
                confirmDeleteBtn.href = deleteUrl;
                
                const modal = new bootstrap.Modal(deleteModalElement);
                modal.show();
            }
        }
    </script>
{% endblock %}
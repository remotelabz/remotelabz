<div class="modal fade {{ class | default('') }}" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="{{ id | default('') }}">{{ title | trans() }}</h5>
        <button type="button" class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {% block body %}{% endblock %}
      </div>
    </div>
  </div>
</div>
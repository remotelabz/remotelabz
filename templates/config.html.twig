{% extends 'dashboard.base.html.twig' %}

{% block breadcrumbs %}
    {%- set breadcrumbs = breadcrumbs|merge({ 'Config': path('admin_config') }) -%}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'config' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
<div class="content-title">
        <div class="content-title-infos">
            <h1>
                Worker configuration
            </h1>
        </div>
    </div>
    <div class="content-body">
        <div {{ react_component('WorkerConfig', props|json_decode(true)) }}></div>
    </div>
{% endblock %}
    
{% block javascripts %}
    {{ parent() }}
{% endblock %}
{% extends 'dashboard.base.html.twig' %}

{% block title %}Edit message - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    {% set breadcrumbs = breadcrumbs|merge({ 'Edit': path('app_site_message_edit', {id: message.id}), 'Messages': path('app_site_message_index') }) %}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'messages' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
    <div class="content-title">
        <div class="content-title-infos">
            <h1>{{ 'Edit message'|trans }}</h1>
            <p class="text-muted">{{ message.title|default(message.type|capitalize) }}</p>
        </div>
        <div class="content-title-actions">
            <a href="{{ path('app_site_message_index') }}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left"></i> {{ 'Back'|trans }}
            </a>
        </div>
    </div>

    {% include 'site_message/form.html.twig' %}
{% endblock %}

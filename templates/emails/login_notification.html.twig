<html>
    <body>
        <p>
            Hello {{ firstName }},<br><br>
            A login was detected on your RemoteLabz account:<br><br>
            <ul>
                <li><strong>Email:</strong> {{ email }}</li>
                <li><strong>Date/Time:</strong> {{ loginDate }}</li>
                <li><strong>Login type:</strong> {{ loginType }}</li>
                <li><strong>IP address:</strong> {{ ip }}</li>
                <li><strong>Browser:</strong> {{ browser }}</li>
                <li><strong>Operating system:</strong> {{ os }}</li>
            </ul>
            <br>
            If you did not initiate this login, please change your password immediately and contact us if needed.<br><br>
            Regards,<br>
            The RemoteLabz team.
        </p>
    </body>
</html>

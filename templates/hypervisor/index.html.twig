{% extends 'dashboard.base.html.twig' %}

{% block breadcrumbs %}
    {%- set breadcrumbs = breadcrumbs|merge({ 'Hypervisor': path('hypervisor') }) -%}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'hypervisor' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
<div class="top-panel">
    <div class="d-flex justify-content-between align-items-center">
            <h3><span class="fa fa-server"></span> {{ 'Hypervisor'|trans }}</h3>
        <div class="quick-actions">
            <a class="btn btn-success" role="button" href="{{ path('new_hypervisor') }}">
                New hypervisor
            </a>
        </div>
    </div>
</div>
<div class="labs-panel">
    <div class="card-body">
 <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
    {% for hypervisor in hypervisor %}
 <tr>
                            <td>{{ hypervisor.name }}</td>
                            <td>
            <a href="{{ path('edit_hypervisor', {'id': hypervisor.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="{{ path('delete_hypervisor', {'id': hypervisor.id}) }}" class="btn btn-sm btn-danger">
                                    <i class="fas fa-edit"></i> Delete
                                </a>
                                </td>
                                </tr>
    {% endfor %} 
    </tbody>
            </table>
 </div>
</div>
{% endblock %}
    
{% block javascripts %}
    {{ parent() }}
    {# {{ encore_entry_script_tags('operating-system') }} #}
{% endblock %}
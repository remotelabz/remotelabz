{% extends 'dashboard.base.html.twig' %}

{% block breadcrumbs %}
    {%- set breadcrumbs = breadcrumbs|merge({ 'Control Protocol Type': path('controlProtocolType') }) -%}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'controlProtocolType' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
<div class="top-panel">
    <div class="d-flex justify-content-between align-items-center">
            <h3><span class="fa fa-network-wired"></span> {{ 'Control protocol'|trans }}</h3>
        <div class="quick-actions">
            <a class="btn btn-success" role="button" href="{{ path('new_controlProtocolType') }}">
                New Control Protocol Type
            </a>
        </div>
    </div>
</div>

<div class="labs-panel">
    <div class="card-body">
<table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>


    {% for controlProtocolType in controlProtocolType %}
        <tr>
            <td>{{ controlProtocolType.name }}</td>
            <td>
                <a href="{{ path('edit_controlProtocolType', {'id': controlProtocolType.id}) }}" class="btn btn-sm btn-primary">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a href="{{ path('delete_controlProtocolType', {'id': controlProtocolType.id}) }}" class="btn btn-sm btn-danger">
                    <i class="fas fa-edit"></i> Delete
                </a>
            </td>
        </tr>
    {% endfor %}
                </tbody>
            </table>
    </div>
</div>

{% endblock %}
    
{% block javascripts %}
    {{ parent() }}
    {# {{ encore_entry_script_tags('operating-system') }} #}
{% endblock %}
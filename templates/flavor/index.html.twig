{% extends 'dashboard.base.html.twig' %}

{% block title %}Flavors - {{ parent() }}{% endblock %}


{% block breadcrumbs %}
    {% set breadcrumbs = breadcrumbs|merge({ 'Flavors': path('flavors') }) %}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'flavors' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
    <div class="content-title">
        <div class="content-title-infos">
            <h3><span class="fa fa-memory"></span> {{ 'Flavors'|trans }}</h3>
        </div>
        <div class="content-title-actions">
            <a href="{{ path('new_flavor') }}" class="btn btn-success">{{ 'New flavor'|trans }}</a>
        </div>
    </div>

<div class="labs-panel mt-3">
    {% if flavors is empty %}
        <div class="text-center py-5">
            <i class="fas fa-hdd fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No flavors Found</h4>
            <p class="text-muted">Get started by creating your first flavor.</p>
            <a href="{{ path('flavor_disk_new') }}" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Create Flavor
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th width="150">Memory size</th>
                        <th width="150" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for flavor in flavors %}
                    <tr>
                        <td>
                            <div class="fw-medium">{{ flavor.name }}</div>
                        </td>
                        <td>
                            <span class="badge bg-primary">
                                <i class="fas fa-memory me-1"></i>
                                {% if flavor.memory >= 1000 %}
                                    {{ (flavor.memory / 1000)|number_format(0, '', '') }} GB
                                {% else %}
                                    {{ flavor.memory }} MB
                                {% endif %}
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="{{ path('edit_flavor', {id: flavor.id}) }}" 
                               class="btn btn-sm btn-outline-primary" 
                               title="{{ 'Edit'|trans }}">
                                <i class="fa fa-edit"></i>
                            </a>
                            <form method="post" 
                                  action="{{ path('delete_flavor', {id: flavor.id}) }}" 
                                  style="display:inline-block;" 
                                  onsubmit="return confirm('{{ 'Are you sure you want to delete this disk flavor?'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flavor.id) }}">
                                <input type="hidden" name="_method" value="DELETE">
                                <button class="btn btn-sm btn-outline-danger" title="{{ 'Delete'|trans }}">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="text-muted mt-3">
            Total: <strong>{{ flavors|length }}</strong> flavor(s)
        </div>
    {% endif %}
</div>


  
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('flavor') }}
{% endblock %}
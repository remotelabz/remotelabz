{% extends 'dashboard.base.html.twig' %}

{% block breadcrumbs %}
    {%- set breadcrumbs = breadcrumbs|merge({ ("Sandbox"): path('sandbox') }) -%}
    {{ parent() }}
{% endblock %}

{% block sidebar %}
    {% set category = 'sandbox' %}
    {{ parent() }}
{% endblock %}

{% block wrapper %}
<div class="content-title">
    <div class="content-title-infos">
        <h1>{{ 'Sandbox'|trans }}</h1>
    </div>
    <div class="content-title-actions">
        {% if (is_granted('ROLE_ADMINISTRATOR') or is_granted('ROLE_TEACHER')) %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importLabModal">
                {{ svg('upload') }} {{ 'Import Lab'|trans }}
            </button>
        {% endif %}
        <a class="btn btn-success"  href="{{path('new_lab_template') }}">{{ 'New Lab'|trans }}</a>
    </div>
</div>
<div class="content-body">
    <form action="{{ path('sandbox') }}" method="GET">
        <div class="row">
            <div class="col">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                    <input type="search" class="form-control input-sm" name="search"
                    placeholder="Search by name"
                    spellcheck="false" value="{{ search|default('') }}">
                </div>
            </div>
        </div>
    </form>
</div>
<div {{ react_component('SandboxManager', props|json_decode(true)) }}></div>

<div class="modal fade import-lab-modal" tabindex="-1" id="importLabModal" aria-labelledby="importLabModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importLabModalLabel">Import a Lab</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    <div {{ react_component('LabImporter', { redirectUrl: path('sandbox') }) }}></div>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
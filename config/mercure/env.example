# Mercure hub secrets (deploy to /etc/remotelabz/mercure.env, chmod 600)
# Values MUST match MERCURE_PUBLISHER_JWT_KEY / MERCURE_SUBSCRIBER_JWT_KEY in the application .env
# Generate new values with: openssl rand -hex 32
MERCURE_PUBLISHER_JWT_KEY=CHANGE_ME_openssl_rand_hex_32
MERCURE_SUBSCRIBER_JWT_KEY=CHANGE_ME_openssl_rand_hex_32
